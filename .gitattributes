# Ensure Unix line endings for shell scripts
*.sh text eol=lf
*.sql text eol=lf

# Ensure proper line endings for other files  
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary