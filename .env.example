# ===========================================
# FULLSTACK AUTH APP - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env and update with your values
# IMPORTANT: Never commit .env to version control!

# ===========================================
# BACKEND API CONFIGURATION
# ===========================================
NODE_ENV=production
PORT=3001

# ===========================================
# DATABASE CONFIGURATION (TiDB)
# ===========================================
DB_HOST=tidb
DB_PORT=4000
DB_USER=root
DB_PASSWORD=
DB_NAME=auth_app
DB_SSL=false

# Connection Pool Settings
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# IMPORTANT: Generate a strong random secret for production!
# Example: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_LONG_RANDOM_STRING
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# Password Hashing (bcrypt rounds)
BCRYPT_ROUNDS=12

# ===========================================
# KAFKA CONFIGURATION
# ===========================================
KAFKA_BROKER=kafka:29092
KAFKA_CLIENT_ID=auth-api
KAFKA_USER_ACTIVITIES_TOPIC=user-activities
KAFKA_DATABASE_CHANGES_TOPIC=database-changes

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=info
LOG_FILE_SIZE=10485760
LOG_FILE_BACKUPS=5
LOG_FILE_COMPRESS=true

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
REACT_APP_API_URL=http://localhost:3001
REACT_APP_ENVIRONMENT=production

# ===========================================
# CLIENT URL (for CORS)
# ===========================================
CLIENT_URL=http://localhost:3000

# ===========================================
# TICDC CONFIGURATION
# ===========================================
TICDC_ADDR=ticdc:8300
TICDC_PD_ADDR=pd:2379

# ===========================================
# EMAIL CONFIGURATION (for password reset)
# ===========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@yourapp.com

# ===========================================
# SESSION CONFIGURATION
# ===========================================
SESSION_SECRET=CHANGE_ME_IN_PRODUCTION_USE_LONG_RANDOM_STRING
SESSION_MAX_AGE=86400000

# ===========================================
# MONITORING & HEALTH CHECKS
# ===========================================
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=5
